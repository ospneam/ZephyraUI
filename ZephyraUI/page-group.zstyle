/* 分组索引页布局 —— Apple HIG 度量。 */

Container.group-chips {
    direction: vertical;
    spacing: 10px;
    cross-align: stretch;
}

Container.page-group {
    direction: vertical;
    spacing: 20px;
    cross-align: stretch;
}

Container.clip-grid-row {
    direction: horizontal;
    spacing: 18px;
    cross-align: stretch;
}

/* AcrylicCard、RoundedCornerOverlay、Dialog、DatePicker、TimePicker
 * —— Apple HIG 度量。
 *
 * 对话框圆角 14px，padding 24px。
 */

/* ---- AcrylicCard ---- */

Container.acrylic-card {
    direction: vertical;
    spacing: 10px;
    padding: 18px;
    width: 280px;
    corner-radius: 12px;
    background: @card;
    border-width: 1px;
    border-color: @card_border;
}

/* ---- RoundedCornerOverlay ---- */

Container.corner-overlay {
    direction: vertical;
    spacing: 10px;
    padding: 18px;
    width: 280px;
    background: transparent;
    border-width: 1px;
    border-color: @card_border;
}

Container.corner-overlay.r7 {
    corner-radius: 12px;
}

Container.corner-overlay.r3 {
    corner-radius: 6px;
}

/* ---- Dialog ---- */

Container.dialog {
    direction: vertical;
    spacing: 14px;
    padding: 28px;
    width: 440px;
    corner-radius: 14px;
    background: @surface_alt;
    border-width: 1px;
    border-color: @card_border;
}

Text.dialog-title {
    text-size: 22px;
    text-color: @content;
}

Text.dialog-text {
    text-size: 15px;
    text-color: @content_secondary;
}

Container.dialog-buttons {
    direction: horizontal;
    main-align: end;
    spacing: 10px;
}

/* ---- DatePicker ---- */

Container.date-picker {
    direction: vertical;
    spacing: 6px;
    padding: 14px;
    width: 320px;
    corner-radius: 10px;
    background: @card;
    border-width: 1px;
    border-color: @card_border;
}

Container.dp-heads {
    direction: horizontal;
    spacing: 6px;
}

Text.dp-head {
    text-size: 13px;
    text-color: @content_secondary;
}

Container.dp-row {
    direction: horizontal;
    spacing: 6px;
}

Container.dp-cell {
    width: 38px;
    height: 38px;
    direction: horizontal;
    main-align: center;
    cross-align: center;
}

Container.dp-day {
    width: 34px;
    height: 34px;
    corner-radius: 99px;
    direction: horizontal;
    main-align: center;
    cross-align: center;
    background: transparent;
}

Container.dp-day.selected {
    background: @accent_fill;
}

Text.dp-day-label {
    text-size: 13px;
    text-color: @content;
}

Text.dp-day-label.selected {
    text-color: @on_accent_fill;
}

/* ---- TimePicker ---- */

Container.time-picker {
    direction: horizontal;
    spacing: 14px;
    padding: 14px;
    corner-radius: 10px;
    background: @card;
    border-width: 1px;
    border-color: @card_border;
}

Container.tp-col {
    direction: vertical;
    spacing: 4px;
}

Container.tp-item {
    width: 68px;
    height: 34px;
    padding: 10px;
    corner-radius: 6px;
    direction: horizontal;
    main-align: center;
    cross-align: center;
    background: transparent;
}

Container.tp-item.selected {
    background: @accent_fill;
}

Text.tp-label {
    text-size: 14px;
    text-color: @content;
}

Text.tp-label.selected {
    text-color: @on_accent_fill;
}

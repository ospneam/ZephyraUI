/* ProgressRing、InfoBar、Toast、ToolTip、BusyIndicator、PageIndicator
 * —— Apple HIG 度量。
 */

/* ---- ProgressRing ---- */

Container.progress-ring {
    direction: horizontal;
    main-align: center;
    cross-align: center;
}

Container.ring-track {
    width: 60px;
    height: 60px;
    corner-radius: 99px;
    background: transparent;
    border-width: 6px;
    border-color: @control_strong;
    direction: horizontal;
    main-align: center;
    cross-align: center;
}

Container.ring-track.running {
    border-color: @accent_fill;
}

Container.ring-track.paused {
    border-color: @caution;
}

Container.ring-track.error {
    border-color: @critical;
}

Text.ring-value {
    text-size: 13px;
    text-color: @content;
}

/* ---- InfoBar ---- */

Container.info-bar {
    direction: horizontal;
    main-align: start;
    cross-align: center;
    spacing: 14px;
    padding: 14px;
    width: 440px;
    corner-radius: 10px;
    background: @surface_alt;
}

Container.info-bar.success {
    background: @success_bg;
}

Container.info-bar.caution {
    background: @caution_bg;
}

Container.info-bar.error {
    background: @critical_bg;
}

Container.bar-icon {
    width: 18px;
    height: 18px;
    icon-color: @content;
}

Container.bar-icon.success {
    icon-color: @success;
}

Container.bar-icon.caution {
    icon-color: @caution;
}

Container.bar-icon.error {
    icon-color: @critical;
}

Container.bar-texts {
    direction: vertical;
    spacing: 4px;
}

Text.bar-title {
    text-size: 14px;
    text-color: @content;
}

Text.bar-text {
    text-size: 13px;
    text-color: @content_secondary;
}

Control.bar-close {
    width: 28px;
    height: 24px;
    corner-radius: 6px;
    direction: horizontal;
    main-align: center;
    cross-align: center;
    background: transparent;
}

Control.bar-close.hovered {
    background: @control_secondary;
}

Container.bar-close-icon {
    width: 14px;
    height: 14px;
    icon-color: @content_secondary;
}

/* ---- Toast ---- */

Container.toast {
    direction: horizontal;
    main-align: start;
    cross-align: center;
    spacing: 14px;
    padding: 14px;
    width: 340px;
    corner-radius: 10px;
    background: @accent_fill;
}

Container.toast.success {
    background: @success;
}

Container.toast.caution {
    background: @caution;
}

Container.toast.error {
    background: @critical;
}

Text.bar-title.success {
    text-color: #ffffff;
}

Text.bar-title.caution {
    text-color: #ffffff;
}

Text.bar-title.error {
    text-color: #ffffff;
}

Text.bar-text.success {
    text-color: #ffffff;
}

Text.bar-text.caution {
    text-color: #ffffff;
}

Text.bar-text.error {
    text-color: #ffffff;
}

/* ---- ToolTip ---- */

Container.tool-tip {
    direction: horizontal;
    main-align: center;
    cross-align: center;
    padding: 10px;
    corner-radius: 8px;
    background: @layer;
    border-width: 1px;
    border-color: @card_border;
}

Text.tip-text {
    text-size: 13px;
    text-color: @content;
}

/* ---- BusyIndicator ---- */

Container.busy {
    direction: horizontal;
    cross-align: center;
    spacing: 10px;
}

Container.busy-dot {
    corner-radius: 99px;
    background: @accent_fill;
}

Container.busy-dot.dot-lg {
    width: 14px;
    height: 14px;
}

Container.busy-dot.dot-md {
    width: 10px;
    height: 10px;
}

Container.busy-dot.dot-sm {
    width: 7px;
    height: 7px;
}

/* ---- PageIndicator ---- */

Container.page-indicator {
    direction: horizontal;
    cross-align: center;
    spacing: 8px;
}

Container.pip {
    width: 7px;
    height: 7px;
    corner-radius: 99px;
    background: @control_strong;
}

Container.pip.selected {
    width: 18px;
    background: @accent_fill;
}

/* Home 页布局 —— Apple HIG 度量。 */

Container.page-home {
    direction: vertical;
    spacing: 22px;
    cross-align: stretch;
}

Container.banner {
    direction: vertical;
    spacing: 10px;
    padding: 28px;
    height: 220px;
    corner-radius: 12px;
    background: #16305c;
}

Text.banner-kicker {
    text-size: 16px;
    text-color: #ffffff;
}

Text.banner-title {
    text-size: 38px;
    text-color: #ffffff;
}

Text.banner-sub {
    text-size: 14px;
    text-color: #ffffff;
}

Container.link-card {
    direction: vertical;
    spacing: 10px;
    padding: 18px;
    width: 320px;
    height: 128px;
}

Container.link-icon {
    width: 26px;
    height: 26px;
    icon-color: @accent_fill;
}

/* 链接卡说明：折行宽度 = 卡宽 320 - 左右 padding 各 18 = 284。
 *
 * `Text` 按整行文本宽度参与布局（既不换行也不裁剪），不设它的话 60 字符的
 * 说明会横向溢出、压到相邻卡片上。与 `Text.clip-desc` 同一处理。
 */
Text.link-desc {
    text-size: 13px;
    text-color: @content_secondary;
    text-max-width: 284px;
}

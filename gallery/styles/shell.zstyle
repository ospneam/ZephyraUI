/* 应用外壳：窗口、标题栏、导航栏、内容卡、页头、通用布局。
 * Apple HIG 度量。
 */

/* ---- 窗口 ---- */

Container.window {
    direction: vertical;
    cross-align: stretch;
    background: @surface;
}

Container.body {
    direction: horizontal;
    cross-align: stretch;
}

/* ---- 标题栏 ---- */

Container.titlebar {
    direction: horizontal;
    main-align: space-between;
    cross-align: center;
    spacing: 16px;
    height: 44px;
    padding: 10px;
    background: @surface_alt;
}

Container.titlebar.mica {
    background: @surface_alt_translucent;
}

Text.app-title {
    text-size: 14px;
    text-color: @content_secondary;
}

Container.search {
    direction: horizontal;
    cross-align: center;
    spacing: 8px;
    width: 340px;
    height: 34px;
    padding: 10px;
    corner-radius: 8px;
    background: @card;
    border-width: 1px;
    border-color: @card_border;
}

Container.search-icon {
    width: 16px;
    height: 16px;
    icon-color: @content_secondary;
}

Container.caption-bar {
    direction: horizontal;
    spacing: 0px;
}

Control.caption-btn {
    width: 44px;
    height: 44px;
    direction: horizontal;
    main-align: center;
    cross-align: center;
    background: transparent;
    corner-radius: 8px;
}

Control.caption-btn.hovered {
    background: @control_secondary;
}

Control.caption-btn.pressed {
    background: @control_tertiary;
}

Control.caption-btn.close.hovered {
    background: @critical;
}

Container.caption-icon {
    width: 14px;
    height: 14px;
    icon-color: @content;
}

/* ---- 导航栏 ---- */

Container.nav-pane.compact {
    width: 56px;
    padding: 6px;
    cross-align: center;
}

Container.nav-pane {
    direction: vertical;
    spacing: 6px;
    padding: 12px;
    width: 260px;
    height: 756px;
    background: @surface_alt;
}

Container.nav-spacer {
    height: 226px;
}

/* ---- 内容卡 ---- */

Container.content-card {
    direction: vertical;
    spacing: 20px;
    width: 1139px;
    height: 756px;
    padding: 28px;
    background: @layer;
    corner-radius: 12px;
}

/* ---- 页头 ---- */

Container.page-header {
    direction: horizontal;
    main-align: space-between;
    cross-align: center;
    spacing: 16px;
}

Container.header-title {
    direction: horizontal;
    cross-align: center;
    spacing: 14px;
}

Text.page-title {
    text-size: 22px;
    text-color: @content;
}

Container.header-tools {
    direction: horizontal;
    cross-align: center;
    spacing: 10px;
}

/* ---- 通用布局 ---- */

Container.section {
    direction: vertical;
    spacing: 14px;
}

Container.section-body {
    direction: vertical;
    spacing: 14px;
}

Container.row {
    direction: horizontal;
    spacing: 14px;
    cross-align: center;
}

Container.stack {
    direction: vertical;
    spacing: 10px;
}

/* ---- 入场动画 ---- */

Container.page {
    direction: vertical;
    cross-align: stretch;
}

Container.page.enter-1 { opacity: 0.00; translate-y: 8px; }
Container.page.enter-2 { opacity: 0.13; translate-y: 7px; }
Container.page.enter-3 { opacity: 0.26; translate-y: 6px; }
Container.page.enter-4 { opacity: 0.39; translate-y: 5px; }
Container.page.enter-5 { opacity: 0.52; translate-y: 4px; }
Container.page.enter-6 { opacity: 0.65; translate-y: 3px; }
Container.page.enter-7 { opacity: 0.78; translate-y: 2px; }
Container.page.enter-8 { opacity: 0.91; translate-y: 1px; }
